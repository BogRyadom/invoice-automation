      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        220
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// One row per invoice; keys match the header row of the Invoices sheet.\nconst event = $input.first().json.body;\nconst p = event.payload;\nconst columns = ['invoice_id', 'document_id', 'vendor', 'vendor_tax_id', 'invoice_number',\n  'invoice_date', 'due_date', 'currency', 'subtotal', 'discount', 'shipping', 'tax_total',\n  'total', 'approval_mode', 'approved_by', 'approved_at'];\nconst row = Object.fromEntries(columns.map((c) => [c, p[c] ?? '']));\nrow.review_url = event.review_url;\nreturn [{ json: row }];\n"
      }
    },
