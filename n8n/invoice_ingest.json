{
  "id": "invoiceIngest001",
  "versionId": "f550ffba-b218-59ed-a707-75fb0a1dc7f0",
  "name": "invoice_ingest",
  "nodes": [
    {
      "id": "dd23414a-ca3e-5b94-aea7-ffd818716797",
      "name": "Gmail: Invoices/Inbox",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.4,
      "position": [
        0,
        300
      ],
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "simple": false,
        "filters": {
          "q": "label:invoices-inbox"
        },
        "options": {
          "downloadAttachments": true,
          "dataPropertyAttachmentsPrefixName": "attachment_"
        }
      }
    },
    {
      "id": "2c6b4f20-68d3-52d4-a816-aa678cd0755b",
      "name": "Split PDF attachments",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// One item per PDF attachment; a message without PDFs gives one item with has_pdf = false.\nconst out = [];\nfor (const item of $input.all()) {\n  const m = item.json;\n  const sender = m.from?.value?.[0]?.address ?? m.from?.text ?? '';\n  const base = {\n    message_id: m.id,\n    sender,\n    subject: m.subject ?? '',\n    received_at: new Date(m.date ?? Date.now()).toISOString(),\n  };\n  const pdfs = Object.entries(item.binary ?? {}).filter(([, b]) =>\n    (b.mimeType ?? '').toLowerCase() === 'application/pdf' ||\n    (b.fileName ?? '').toLowerCase().endsWith('.pdf'));\n  if (pdfs.length === 0) {\n    out.push({ json: { ...base, has_pdf: false } });\n    continue;\n  }\n  for (const [key, b] of pdfs) {\n    out.push({\n      json: { ...base, has_pdf: true, attachment_id: key, filename: b.fileName ?? key },\n      binary: { file: b },\n    });\n  }\n}\nreturn out;\n"
      }
    },
    {
      "id": "51279a86-a386-5c69-b558-af676dd2d207",
      "name": "Has PDF",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        440,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "4e8bfa1f-6f7b-5170-a0a6-1719d9f177f9",
              "leftValue": "={{ $json.has_pdf }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "a3e743cc-52b5-5f52-8c6f-b91a405fb70b",
      "name": "POST /api/documents",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        660,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.API_URL }}/api/documents",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Ingest-Secret",
              "value": "={{ $env.INGEST_SHARED_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "file",
              "inputDataFieldName": "file"
            },
            {
              "parameterType": "formData",
              "name": "gmail_message_id",
              "value": "={{ $json.message_id }}"
            },
            {
              "parameterType": "formData",
              "name": "attachment_id",
              "value": "={{ $json.attachment_id }}"
            },
            {
              "parameterType": "formData",
              "name": "sender",
              "value": "={{ $json.sender }}"
            },
            {
              "parameterType": "formData",
              "name": "subject",
              "value": "={{ $json.subject }}"
            },
            {
              "parameterType": "formData",
              "name": "received_at",
              "value": "={{ $json.received_at }}"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput"
    },
    {
      "id": "2cf1c0c8-69aa-5384-9cfb-386b5e6f93c3",
      "name": "Label: Received",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        900,
