# Copy to .env and fill in the empty values. Never commit .env.
# Local Supabase values are printed by `npx supabase status`.

# Database (direct Postgres connection, local Supabase stack by default)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:54322/postgres
# Admin connection used by pytest to create throwaway databases
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:54322/postgres

# Supabase (backend). The secret key replaces the legacy service_role key.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=invoices
SIGNED_URL_TTL_SECONDS=300

# Supabase (web, safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000

# Shared secrets between n8n and the API, both directions
INGEST_SHARED_SECRET=
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# LLM provider. Model ids checked against https://console.groq.com/docs/models on 2026-10-06.
# The vision model must accept images and strict json_schema output.
LLM_PROVIDER=groq
LLM_MODEL_TEXT=openai/gpt-oss-120b
LLM_MODEL_VISION=qwen/qwen3.8-27b
GROQ_API_KEY=
LLM_REASONING_EFFORT_TEXT=low
LLM_REASONING_EFFORT_VISION=none
# Images per request accepted by the vision model; longer scans fail as too_large
LLM_MAX_VISION_PAGES=3
LLM_TIMEOUT_SECONDS=60
LLM_MAX_ATTEMPTS=3
# Longest wait honoured for a rate-limit retry; longer waits (daily limit) fail at once
LLM_MAX_WAIT_SECONDS=60

# File limits. Above INGEST_MAX_FILE_MB the API rejects the upload (413).
# Above MAX_FILE_MB or MAX_PAGES the document is stored and marked failed: too_large.
MAX_FILE_MB=15
INGEST_MAX_FILE_MB=50
MAX_PAGES=20

# Worker and outbox
WORKER_POLL_INTERVAL_SECONDS=2
PROCESSING_TIMEOUT_SECONDS=300
WORKER_MAX_ATTEMPTS=3
OUTBOX_MAX_ATTEMPTS=5

# Checks and routing
AMOUNT_TOLERANCE=0.02
AUTO_APPROVE_ENABLED=false
# Single threshold compared to the invoice total regardless of currency (v1 limitation)
AUTO_APPROVE_MAX_TOTAL=5000
VENDOR_FUZZY_THRESHOLD=85

# App
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=INFO
